  "cards": [
    {
      "dot": "cyan",
      "title": "kb-collect flow (steps 1–10)",
      "items": [
        "1–2  @moose record the knowledge in a thread; Slack sends the event",
        "3–5  allowlist check, then the router (one tool-less LLM call) picks kb-collect",
        "6  the skill reads the thread via the Slack Web API, drops noise (acks, repeated bot alerts) and redacts secrets",
        "7  summarize with a tool-less LLM call (map-reduce for long threads); output: cause, ruled out, fix, outcome, cited messages",
        "8  code upserts the Onyx doc neotags-slack-<channel>-<thread_ts>: summary + verbatim key excerpts",
        "9–10  reply in thread with link and an Undo button (deletes the doc)"
      ]
    },
    {
      "dot": "violet",
      "title": "Skills vs the agent runtime",
      "items": [
        "A skill is a fixed procedure with its own permissions; the router only picks which one",
        "kb-collect calls the LLM client, Onyx and Notifier directly: no agent loop needed",
        "The O2 assistant runs a pi Agent per question (RunManager: queue, per-session lock, budgets, drain)",
        "Every agent tool call passes a code-side guard first: MCP Tool Guard, or the sandbox guard for skill-pack commands"
      ]
    },
    {
      "dot": "emerald",
      "title": "Implemented",
      "items": [
        "Slack gateway, dedupe, graceful drain, allowlists",
        "LLM router with optional faster router model",
        "kb-collect: thread reader, redaction, summarizer, Onyx upsert + Undo",
        "OpenAI-compatible gateway via pi-ai, verified live; Agent factory + tool guard ready",
        "LLM traces over OTLP: one trace per task or agent run, a span per LLM request and tool call (model, tokens, latency)",
        "OpenObserve assistant: O2 gateway (:3001, SSE), agent runs with O2 MCP tools, evidence links and navigation",
        "MCP client + Tool Guard; executor sidecar (bubblewrap) behind the sandbox guard"
      ]
    },
    {
      "dot": "amber",
      "title": "Planned",
      "items": [
        "Live verification: Slack, Onyx and the O2 assistant end to end",
        "Slack answers and alert triage on the Agent runtime",
        "Alert webhook, scheduler, GitHub/GitLab bot"
      ]
    }
  ]
