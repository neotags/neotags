#!/bin/sh
# Scan staged changes for secrets before committing.
# Enabled by `make hooks` (sets core.hooksPath=.githooks).
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks not found; skipping secret scan (brew install gitleaks)" >&2
  exit 0
fi
gitleaks git --pre-commit --staged --config .gitleaks.toml --verbose .
